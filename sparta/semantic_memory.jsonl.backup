{"id": "energy_conservation", "domain": "Physics", "subdomain": "Thermodynamics", "topic": "Conservation of Energy", "definition": "Energy cannot be created or destroyed, only transformed from one form to another", "formal_statement": "∑E_initial = ∑E_final for all isolated systems", "relations": ["entropy", "thermodynamics_second_law", "momentum"], "prerequisites": [], "confidence": 1.0, "source": "fundamental_law", "reflex_tag": "RFX_PHYS_001", "examples": ["Pendulum converting potential to kinetic energy", "Chemical energy in battery converting to electrical energy"], "counterexamples": ["Energy appearing from nothing (violates law)", "Perpetual motion machines (impossible)"], "applications": ["Power plant efficiency calculations", "Mechanical system design"], "verification": "Experimentally verified in all closed systems across all scales", "uncertainty": "Behavior at quantum-gravitational scales (Planck scale) may require modification"}
{"id": "entropy", "domain": "Physics", "subdomain": "Thermodynamics", "topic": "Entropy", "definition": "A measure of disorder or randomness in a system, which tends to increase over time in isolated systems", "formal_statement": "ΔS_universe ≥ 0 for all processes", "relations": ["energy_conservation", "thermodynamics_second_law"], "prerequisites": [], "confidence": 1.0, "source": "fundamental_law", "reflex_tag": "RFX_PHYS_002", "examples": ["Ice melting into water (entropy increases)", "Gas expanding into vacuum"], "counterexamples": ["Local entropy decrease (possible if system not isolated)", "Perpetual decrease in closed system (impossible)"], "applications": ["Heat engine efficiency limits", "Information theory"], "verification": "Statistical mechanics derivation and experimental validation", "uncertainty": "Entropy arrow of time origin remains open question in cosmology"}
{"id": "newton_first_law", "domain": "Physics", "subdomain": "Mechanics", "topic": "Newton's First Law (Inertia)", "definition": "An object at rest stays at rest and an object in motion stays in motion with the same speed and direction unless acted upon by an unbalanced force", "formal_statement": "If ∑F = 0, then dv/dt = 0", "relations": ["momentum", "energy_conservation"], "prerequisites": [], "confidence": 1.0, "source": "fundamental_law", "reflex_tag": "RFX_PHYS_003", "examples": ["Hockey puck sliding on frictionless ice", "Spacecraft coasting in deep space"], "counterexamples": ["Object accelerating without force (violates law)", "Car stopping by itself (friction is the force)"], "applications": ["Spacecraft trajectory calculations", "Vehicle safety systems"], "verification": "Experimentally validated in inertial reference frames", "uncertainty": "Non-inertial reference frames require correction terms"}
{"id": "momentum", "domain": "Physics", "subdomain": "Mechanics", "topic": "Momentum Conservation", "definition": "The product of an object's mass and velocity, a conserved quantity in closed systems", "formal_statement": "∑(m_i × v_i) = constant for isolated systems", "relations": ["newton_first_law", "energy_conservation"], "prerequisites": [], "confidence": 1.0, "source": "fundamental_law", "reflex_tag": "RFX_PHYS_004", "examples": ["Billiard ball collisions", "Rocket propulsion"], "counterexamples": ["Momentum lost in collision without external force (impossible)", "Isolated system changing total momentum (violates conservation)"], "applications": ["Collision analysis", "Rocket trajectory calculations"], "verification": "Derived from Newton's laws and validated experimentally", "uncertainty": "Relativistic corrections needed at high velocities"}
{"id": "thermodynamics_second_law", "domain": "Physics", "subdomain": "Thermodynamics", "topic": "Second Law of Thermodynamics", "definition": "The total entropy of an isolated system can never decrease over time, and is constant if and only if all processes are reversible", "formal_statement": "ΔS_total ≥ 0, with equality only for reversible processes", "relations": ["entropy", "energy_conservation"], "prerequisites": ["entropy"], "confidence": 1.0, "source": "fundamental_law", "reflex_tag": "RFX_PHYS_005", "examples": ["Heat flowing from hot to cold", "Irreversible mixing of gases"], "counterexamples": ["Heat spontaneously flowing from cold to hot (impossible)", "Unmixing of gases without work (violates law)"], "applications": ["Heat engine limits (Carnot efficiency)", "Refrigeration thermodynamics"], "verification": "No violations observed in macroscopic isolated systems", "uncertainty": "Microscopic fluctuations can show temporary local decreases"}
